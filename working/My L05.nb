Notebook[{
Cell[TextData[{
 StyleBox["Q2: Integrate the expression f(x) = sin(x) ",
  FontSize->15],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"-", "x"}]], TraditionalForm]],
  FontSize->15,ExpressionUUID->"9e2b94ce-3c9d-465e-b58d-2fd0f066db7e"],
 StyleBox[", and then take its derivative.\n",
  FontSize->15]
}], "Text",
 CellFrame->{{0, 0}, {0, 1}},
 CellChangeTimes->{3.978077164496662*^9, 
  3.978077774526083*^9},ExpressionUUID->"02a18cc7-d8cf-4e2a-bad6-\
385bdb1694ba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    StyleBox["sin",
     FontSize->15], 
    StyleBox[
     RowBox[{"(", "x", ")"}],
     FontSize->15], 
    StyleBox[" ",
     FontSize->15], 
    FormBox[
     SuperscriptBox["e", 
      RowBox[{"-", "x"}]],
     TraditionalForm]}], ",", " ", "x"}], "]"}]], "Input",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.978077229601097*^9, 3.978077231347925*^9}, {
  3.978077464280272*^9, 3.978077484679887*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"32254b76-1dc7-4dea-a99e-cdd0e24a2f9c"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    SuperscriptBox["e", 
     RowBox[{"-", "x"}]], " ", "sin", " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"x", " ", 
       RowBox[{"Log", "[", "e", "]"}]}]}], ")"}]}], 
   SuperscriptBox[
    RowBox[{"Log", "[", "e", "]"}], "2"]]}]], "Output",
 CellChangeTimes->{3.978077485875646*^9},
 CellLabel->"Out[7]=",ExpressionUUID->"9bdc6ee3-86e8-4e7c-9123-d9a617272693"]
}, Open  ]],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      RowBox[{
       SuperscriptBox["e", 
        RowBox[{"-", "x"}]], " ", "sin", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"x", " ", 
          RowBox[{"Log", "[", "e", "]"}]}]}], ")"}]}], 
      SuperscriptBox[
       RowBox[{"Log", "[", "e", "]"}], "2"]]}], ",", " ", "x"}], "]"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.978077526743325*^9, 3.9780775275069637`*^9}, {
  3.978077597385562*^9, 3.978077599328804*^9}, {3.97807770251658*^9, 
  3.97807770755239*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"067456b5-df87-4b27-abf5-4f9300396eab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox["e", 
    RowBox[{"-", "x"}]], " ", "sin", " ", "x"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.9780777718740997`*^9, 3.9780777718760633`*^9}, {
  3.9780780285585327`*^9, 
  3.9780780414320498`*^9}},ExpressionUUID->"efa6579d-e271-402f-b1b6-\
35b72b3860ad"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["e", 
   RowBox[{"-", "x"}]], " ", "sin", " ", "x"}]], "Output",
